#!/usr/bin/env python3
r"""memos-init — create a git memory repo that any AI client can read.

Usage:
    memos-init [directory] [--git] [--force]

Creates the layout defined in SPEC.md, an AGENTS.md instruction file that
tells a coding agent how to use it, and one example memory so the repo is
not empty on first read. With --git it also initialises git and installs a
pre-commit hook that runs the format check.

On Windows run it as:  py bin\memos-init %USERPROFILE%\my-memory --git
(or use bin\memos-init.cmd). `~` is expanded on every platform.

No dependencies. Python 3.8+. Windows, macOS and Linux.
"""

import os
import shutil
import subprocess
import sys
from datetime import date

LAYOUT = ["memory", "memory/archive"]

INDEX = """# Memory Index

One line per live memory. Nothing else belongs in this file.

- [how-i-work](how-i-work.md) — delete this example once you have written a real memory
"""

EXAMPLE = """---
name: how-i-work
type: user
description: delete this example once you have written a real memory
effective_from: {today}
source: created by memos-init
---

This file exists so the repo is not empty the first time a client reads it.

Replace it with something true. A good first memory is the thing you are
tired of repeating: your stack, your deploy rule, the name of the person who
approves releases.

Then delete this line from `INDEX.md` and add yours.
"""

AGENTS = """# Memory

This repository is your memory. Read it before you answer, and write to it
when you learn something that will still be true next week.

The format is defined in SPEC.md. The short version:

## Reading

1. Read `memory/INDEX.md` first. It lists every current memory, one line each.
2. Open the files whose description looks relevant.
3. Never read `memory/archive/` unless you are asked what used to be true.
   Everything in there is false now, by definition.

## Writing

When you learn a durable fact — a decision, a preference, a constraint, a
pointer to something — write it down:

1. Check `INDEX.md` for a memory that already covers it.
2. If none exists, create `memory/<slug>.md` with this frontmatter:

```
---
name: <slug>
type: user | project | decision | reference
description: <one line>
effective_from: <YYYY-MM-DD>
source: <where this came from>
---
```

3. Add one line to `INDEX.md`: `- [<slug>](<slug>.md) — <description>`
4. Commit both files together.

One memory is one fact. If you are writing "and" in the description, it is
two memories.

## When a fact changes

Never edit a memory in place. Supersede it:

1. Move the old file to `memory/archive/<slug>.<YYYY-MM-DD>.md`
2. Add `effective_to:` and `superseded_by:` to its frontmatter
3. Write the new memory with `supersedes: <old-slug>`
4. Replace the line in `INDEX.md`
5. Commit it all together

## Never

- Never put a credential, token or password in a memory.
- Never delete a memory file. Archive it.
- Never write a memory about something that is already in the code or the
  git history. Write what the repo cannot tell you.
"""

GITIGNORE = """.DS_Store
Thumbs.db
desktop.ini
*.swp
.env
__pycache__/
"""

# Memory files are shared between Windows, macOS and Linux machines.
# Store them with LF so a Windows checkout never produces a CRLF diff on
# every line, and never lets git "fix" line endings behind your back.
GITATTRIBUTES = """* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
"""

# Runs under the sh that ships with Git for Windows, and under macOS/Linux.
# Probes each interpreter name: on Windows `python3` is often the Microsoft
# Store stub, which exists on PATH but does not run Python.
HOOK = """#!/bin/sh
# JMac Memory OS format check. Installed by memos-init.
here="$(git rev-parse --show-toplevel)"
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1; then
    exec "$py" "$here/.memos/read.py" --dir "$here" check
  fi
done
echo "memory pre-commit: no Python 3.8+ found, format check skipped" >&2
exit 0
"""

README = """# My Memory

Personal memory for AI assistants, in the JMac Memory OS format.

Read `memory/INDEX.md` to see what is in here.
Format: https://github.com/JMacCyber/jmac-memory-os
"""


def die(msg):
    print(f"memos-init: {msg}", file=sys.stderr)
    sys.exit(1)


def write(path, text, force):
    if os.path.exists(path) and not force:
        print(f"  skip   {path} (exists)")
        return False
    # newline="\n": LF on every OS, so files are byte-identical everywhere.
    with open(path, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)
    print(f"  write  {path}")
    return True


def main(argv):
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    args = [a for a in argv if not a.startswith("--")]
    flags = {a for a in argv if a.startswith("--")}
    unknown = flags - {"--git", "--force", "--help", "-h"}
    if unknown:
        die(f"unknown option: {', '.join(sorted(unknown))}")
    if "--help" in flags or "-h" in flags:
        print(__doc__)
        return 0

    target = args[0] if args else "."
    # PowerShell and cmd.exe pass `~` through literally; expand it ourselves.
    root = os.path.abspath(os.path.expandvars(os.path.expanduser(target)))
    force = "--force" in flags
    today = date.today().isoformat()

    os.makedirs(root, exist_ok=True)
    for d in LAYOUT:
        os.makedirs(os.path.join(root, d), exist_ok=True)
    print(f"memory repo at {root}")

    write(os.path.join(root, "memory", "INDEX.md"), INDEX, force)
    write(os.path.join(root, "memory", "how-i-work.md"),
          EXAMPLE.format(today=today), force)
    write(os.path.join(root, "AGENTS.md"), AGENTS, force)
    write(os.path.join(root, "CLAUDE.md"), "See AGENTS.md.\n", force)
    write(os.path.join(root, ".gitignore"), GITIGNORE, force)
    write(os.path.join(root, ".gitattributes"), GITATTRIBUTES, force)
    # Ship the reader inside the memory repo so the check and hook work on
    # any machine that clones it, with nothing else installed.
    reader_src = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              os.pardir, "reader", "read.py")
    os.makedirs(os.path.join(root, ".memos"), exist_ok=True)
    reader_dst = os.path.join(root, ".memos", "read.py")
    if os.path.exists(reader_src) and (force or not os.path.exists(reader_dst)):
        shutil.copyfile(reader_src, reader_dst)
        print(f"  write  {reader_dst}")
    write(os.path.join(root, "README.md"), README, force)

    if "--git" in flags:
        if os.path.isdir(os.path.join(root, ".git")):
            print("  skip   git init (already a repo)")
        else:
            try:
                subprocess.run(["git", "init", "-q", "-b", "main"],
                               cwd=root, check=True)
                # Honour .gitattributes on Windows even if the global
                # core.autocrlf=true default from the Git installer is set.
                subprocess.run(["git", "config", "core.autocrlf", "false"],
                               cwd=root, check=True)
                hook = os.path.join(root, ".git", "hooks", "pre-commit")
                with open(hook, "w", encoding="utf-8", newline="\n") as fh:
                    fh.write(HOOK)
                os.chmod(hook, 0o755)
                print("  hook   pre-commit runs the format check")
                subprocess.run(["git", "add", "."], cwd=root, check=True)
                subprocess.run(
                    ["git", "commit", "-q", "-m", "Start memory"],
                    cwd=root, check=True)
                print("  git    initialised, one commit")
            except FileNotFoundError:
                die("git is not installed")
            except subprocess.CalledProcessError as exc:
                die(f"git failed: {exc} If this is a new machine, set your"
                    " identity first:\n  git config --global user.name \"Your Name\""
                    "\n  git config --global user.email you@example.com")

    print("""
Next:
  1. Create a PRIVATE repo on GitHub and push this.
  2. Point your tools at it — see clients/ in the jmac-memory-os repo.
  3. Tell your agent: "read AGENTS.md, then read memory/INDEX.md".
""")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
